{
  "name": "htx-task-assignment",
  "private": true,
  "version": "1.0.0",
  "description": "Task Assignment App — assign tasks to developers by skill, with subtasks and LLM-inferred skills",
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "predev": "tsc -b packages/shared",
    "dev": "concurrently -k -n shared,api,web -c blue,green,magenta \"npm:dev -w @htx/shared\" \"npm:dev -w @htx/api\" \"npm:dev -w @htx/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose up -d db",
    "db:migrate": "npm run migrate -w @htx/api",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/pg": "8.23.1",
    "concurrently": "10.0.5",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  }
}
