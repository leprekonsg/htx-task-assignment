{
  "name": "@htx/api",
  "private": true,
  "version": "1.0.0",
  "description": "Fastify + PostgreSQL API for the Task Assignment App",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc -b",
    "start": "node dist/server.js",
    "migrate": "tsx --env-file=../../.env src/db/cli.ts migrate",
    "demo": "tsx --env-file=../../.env src/db/cli.ts demo",
    "empty": "tsx --env-file=../../.env src/db/cli.ts empty",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@google/genai": "2.19.0",
    "@htx/shared": "*",
    "fastify": "5.12.1",
    "fastify-type-provider-zod": "7.0.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.13",
    "vitest": "4.1.11"
  }
}
