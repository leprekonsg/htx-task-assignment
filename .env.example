# Copy to .env and fill in. Docker Compose reads this file automatically.

# Gemini API key from https://aistudio.google.com/apikey — optional.
# Without it the app still works; tasks created without skills are stored as `skills_source = unresolved`.
GEMINI_API_KEY=

# Model chain for skill inference (first that answers wins). Leave the defaults unless you have a reason.
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODELS=gemma-4-31b-it,gemma-4-26b-a4b-it

# Postgres (compose overrides DATABASE_URL to point at the `db` service)
POSTGRES_USER=taskapp
POSTGRES_PASSWORD=taskapp
POSTGRES_DB=taskapp
DATABASE_URL=postgresql://taskapp:taskapp@localhost:5432/taskapp

# API
PORT=3000
